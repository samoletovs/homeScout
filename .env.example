# homeScout — environment template. No real secrets or personal figures here.
# Real secrets  -> functions/local.settings.json (git-ignored) or Function App / SWA settings.
# Personal data (budget, shortlist, offers) -> OneDrive .me vault, NEVER this repo.

# --- Hard filters (set real values in your LOCAL env, never here) ---
HOMESCOUT_MAX_PRICE=          # your budget ceiling (keep local only)
HOMESCOUT_MIN_ROOMS=          # e.g. 4
HOMESCOUT_MAX_COMMUTE=        # minutes, e.g. 30
HOMESCOUT_EXCLUDE_FLOOD=1
HOMESCOUT_EXCLUDE_GROUND=0    # 1 = drop ground-floor flats

# --- Data sources / APIs ---
CITY24_API_BASE=https://api.city24.ee/lv_LV
SSLV_RSS_BASE=https://www.ss.lv/lv/real-estate/flats
VZD_NITIS_DATASET=nekustama-ipasuma-tirgus-datu-bazes-atvertie-dati
ORS_API_KEY=                     # OpenRouteService (commute), free tier
HOMESCOUT_COMMUTE_DEST=56.9489,24.1064   # lat,lon commute target (default: central Rīga)

# --- LLM (adviser take; leave blank to run without it) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
HOMESCOUT_LANG=ru            # family communication language (data stays English)

# --- Notify ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
COSMOS_ENDPOINT=
COSMOS_DATABASE=homescout
