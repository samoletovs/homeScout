# homeScout — environment template. No real secrets or personal figures here.
# Real secrets  -> functions/local.settings.json (git-ignored) or Function App / SWA settings.
# Personal data (budget, shortlist, offers) -> private local storage, NEVER this repo.

# --- Hard filters (relevance). Room/area floors default to 4 rooms / 75 m² in code;
#     price bounds are env-only (never a budget figure in the repo). ---
HOMESCOUT_MAX_PRICE=          # budget ceiling, e.g. 400000 (keep local only)
HOMESCOUT_MIN_PRICE=          # floor to drop tiny/cheap noise, e.g. 100000 (local only)
HOMESCOUT_MIN_ROOMS=4         # family of 4 → big home
HOMESCOUT_MIN_AREA=75         # m² floor (a real 4-room is usually ≥85)
HOMESCOUT_MAX_COMMUTE=        # minutes, e.g. 30
HOMESCOUT_EXCLUDE_FLOOD=1
HOMESCOUT_EXCLUDE_GROUND=0    # 1 = drop ground-floor flats
HOMESCOUT_EXCLUDE_RENTED=1    # drop currently-rented (not move-in-ready) listings
HOMESCOUT_REQUIRE_READY=1     # drop unfinished / no-finishing listings

# --- Data sources / APIs ---
CITY24_API_BASE=https://api.city24.ee/lv_LV
SSLV_RSS_BASE=https://www.ss.lv/lv/real-estate/flats
VZD_NITIS_DATASET=nekustama-ipasuma-tirgus-datu-bazes-atvertie-dati
ORS_API_KEY=                     # OpenRouteService (commute), free tier
HOMESCOUT_COMMUTE_DEST=56.9489,24.1064   # lat,lon commute target (default: central Rīga)

# --- LLM (adviser take; leave blank to run without it) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# NOTE: AZURE_OPENAI_DEPLOYMENT is a deployment alias, not necessarily a model
# name. Confirm the endpoint and deployment pair before relying on model behavior:
#   az cognitiveservices account deployment list -n <account> -g <rg> \
#     --query "[].{deployment:name,model:properties.model.name}" -o table
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
HOMESCOUT_LANG=ru            # family communication language (data stays English)

# --- Notify ---
TELEGRAM_BOT_TOKEN=
# Comma-separated: every family member's chat id (or one group chat id). A bot cannot
# message someone who has not started a chat with it, so list each member explicitly.
TELEGRAM_CHAT_ID=

# --- Feedback intake (agentMode gate -> POST /api/feedback, function-key protected) ---
HOMESCOUT_FEEDBACK_MAX_COMMENT=500        # cap stored comment length
# On Azure Functions the state+knowledge DB auto-uses the persistent HOME share. Override:
# HOMESCOUT_DB=data/homescout.sqlite

# --- Storage ---
COSMOS_ENDPOINT=
COSMOS_DATABASE=homescout
